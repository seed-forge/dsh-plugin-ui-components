{
  "name": "@seed-forge/dsh-plugin-ui-components",
  "version": "0.1.0",
  "description": "Host-aware React compound components and contracts for DeepSeek Harness web plugins.",
  "keywords": [
    "deepseek",
    "dsh",
    "react",
    "ui",
    "components",
    "agent",
    "plugin"
  ],
  "license": "MIT",
  "author": "SeedForge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seed-forge/dsh-plugin-ui-components.git"
  },
  "bugs": {
    "url": "https://github.com/seed-forge/dsh-plugin-ui-components/issues"
  },
  "homepage": "https://github.com/seed-forge/dsh-plugin-ui-components#readme",
  "packageManager": "pnpm@10.30.3",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js",
      "require": "./dist/contracts/index.cjs"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "import": "./dist/registry/index.js",
      "require": "./dist/registry/index.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js",
      "require": "./dist/tokens/index.cjs"
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "import": "./dist/styles.js",
      "require": "./dist/styles.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:dsh-proof": "pnpm run build && node scripts/build-dsh-proof-client.mjs",
    "check:dsh-proof": "node scripts/build-dsh-proof-client.mjs --check && node --check examples/dsh-status-dock/src/index.js && node --check examples/dsh-status-dock/src/client.js && node --test examples/dsh-status-dock/test/client-bundle.test.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "prepack": "pnpm run build",
    "pack": "pnpm pack --pack-destination .artifacts",
    "pack:checked": "node scripts/pack.mjs",
    "verify:consumer": "pnpm run typecheck && pnpm test",
    "verify:consumer:tarball": "node scripts/verify-consumer.mjs",
    "release:check": "pnpm run typecheck && pnpm test && pnpm run build:dsh-proof && pnpm run check:dsh-proof && pnpm run pack:checked && pnpm run verify:consumer:tarball"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.0.1-rc.1",
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitest/coverage-v8": "^3.1.3",
    "jsdom": "^26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=10.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
